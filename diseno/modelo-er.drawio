a.id"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel7" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;startArrow=ERmany;startFill=0;endArrow=ERzeroToOne;endFill=0;endSize=10;startSize=10;strokeWidth=1.5;strokeColor=#36454F;dashed=1;" edge="1" parent="1" source="venta.cliente_id" target="cliente.id"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel8" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;endSize=10;startSize=10;strokeWidth=1.5;strokeColor=#36454F;" edge="1" parent="1" source="detalle_venta.venta_id" target="venta.id"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel9" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;endSize=10;startSize=10;strokeWidth=1.5;strokeColor=#36454F;" edge="1" parent="1" source="detalle_venta.producto_id" target="producto.id"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nota_calculados" value="&lt;b&gt;Se calculan y no se guardan (evita redundancia):&lt;/b&gt;&lt;br&gt;• caja.diferencia = monto_contado − monto_esperado (RF-08)&lt;br&gt;• venta.vuelto = monto_recibido − total (RF-06)&lt;br&gt;&lt;b&gt;Se guardan a propósito:&lt;/b&gt; producto.stock (RF-04, RF-06), venta.subtotal / impuesto / total y detalle_venta.precio_unitario / subtotal (el ticket no cambia aunque cambien precios o el % de impuesto; los reportes RF-09 suman estos campos)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#333333;strokeColor=#999999;dashed=1;fillColor=#FAFAFA;spacing=8;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1205" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>